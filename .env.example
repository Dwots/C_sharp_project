# Образец файла секретов. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
#
# Сам .env в git не попадает (см. .gitignore), .env.example — попадает.
# docker compose подхватывает .env автоматически из корня проекта.

# Токен бота от @BotFather, вида 1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
TELEGRAM_BOT_TOKEN=

# Идентификатор чата, куда слать алерты. Число, может быть отрицательным для групп.
TELEGRAM_CHAT_ID=
