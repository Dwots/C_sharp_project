{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Partitioning": {
    "JobEnabled": true,
    "IntervalMinutes": 60,
    "Targets": [
      {
        "Schema": "public",
        "Table": "play_sessions",
        "Granularity": "Month",
        "HorizonUnits": 3
      },
      {
        "Schema": "lab03",
        "Table": "events",
        "Granularity": "Day",
        "HorizonUnits": 3
      }
    ]
  },

  "Alerting": {
    "Telegram": {
      "BotToken": "",
      "ChatId": ""
    }
  }
}
